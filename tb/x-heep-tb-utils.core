name: x-heep::tb-utils
description: X-HEEP testbench files.

filesets:
  # Pin-level models used as drivers
  files_examples:
    depend:
    - example:ip:pdm2pcm_dummy
    - example:ip:i2s_microphone

  files_verilator_waiver:
    files:
    - tb.vlt
    file_type: vlt

  tb-harness:
    files:
    - tb_util.svh: {is_include_file: true}
    - tb_pkg.sv
    - tb_pads_pkg.sv
    - yosys_spiflash.sv
    - vdrivers/vdrv_jtag.sv
    - vdrivers/vdrv_uart.sv
    - vdrivers/vdrv_spi_mem.sv
    - vdrivers/vdrv_gpio.sv
    - vdrivers/vdrv_i2c.sv
    - vdrivers/vdrivers.sv
    - vinterconnect.sv
    - testharness.sv
    file_type: systemVerilogSource

generate:
  waivers-v5:
    generator: waiver-v5-gen
    parameters:
      waivers_v5:
      - tb_v5.vlt

targets:
  default: &default_target
    filesets:
    - files_examples
    - tb-harness
    - tool_verilator? (files_verilator_waiver)
    generate:
    - tool_verilator ? (waivers-v5)
